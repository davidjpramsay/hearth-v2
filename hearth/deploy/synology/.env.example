HEARTH_VERSION=replace-with-tested-release-or-commit
HEARTH_UID=1000
HEARTH_GID=1000
HEARTH_HTTP_PORT=8432
HEARTH_LOG_LEVEL=info
HEARTH_BACKUP_RETENTION=14
HEARTH_BACKUP_INTERVAL_HOURS=24

# Approximate household coordinates are enough; keep them server-side.
# Both values must be set to enable Open-Meteo weather.
HEARTH_WEATHER_LATITUDE=
HEARTH_WEATHER_LONGITUDE=

# Leave blank until one exact Synology photo folder is approved and mounted read-only.
HEARTH_PHOTO_SOURCE_DIR=
HEARTH_PHOTO_COLLECTION_NAME=Family photos
HEARTH_PHOTO_SCAN_MINUTES=15
# HEARTH_PHOTO_HOST_DIR=/volume1/photo/Hearth
HEARTH_DATA_DIR=./runtime/data
HEARTH_SECRETS_DIR=./runtime/secrets
HEARTH_AUTH_RP_ID=hearth.home.arpa
HEARTH_AUTH_ORIGIN=https://hearth.home.arpa
