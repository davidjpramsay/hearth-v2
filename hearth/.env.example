# Phases 0–5 run with isolated deterministic demo data by default.
HEARTH_MODE=demo
HEARTH_HOST=127.0.0.1
HEARTH_PORT=4310
HEARTH_LOG_LEVEL=info

# Optional private-mode calendar adapter. This points to a server-only JSON
# secret mounted outside the repository; never paste credentials into .env.
# Supplying it in demo mode is rejected by design.
# HEARTH_CALENDAR_CONFIG_PATH=/run/secrets/hearth-calendar.json

# Phase 5 uses a fake Home Assistant adapter. A future live adapter will read a
# server-only secret reference; never place a Home Assistant token in this file.

# Browser-safe path only. Never place service credentials in a VITE_ variable.
VITE_HEARTH_API_BASE=/api/v1
