# Use demo for fictional local evaluation. Test is reserved for automated
# deterministic harnesses. Private uses the real clock and never seeds demo data.
HEARTH_MODE=demo
HEARTH_HOST=127.0.0.1
HEARTH_PORT=4310
HEARTH_LOG_LEVEL=info

# Optional explicit database path. When omitted, private mode uses
# data/hearth-private.sqlite and demo/test use data/hearth-demo.sqlite.
# HEARTH_DATABASE_PATH=/var/lib/hearth/hearth.sqlite

# Optional private-mode calendar adapter. This points to a server-only JSON
# secret path outside the repository that Hearth may atomically create/replace;
# never paste credentials into .env.
# Supplying it in demo mode is rejected by design.
# HEARTH_CALENDAR_CONFIG_PATH=/run/secrets/hearth-calendar.json

# Optional private-mode photo adapter. Mount exactly one approved family folder
# read-only and keep TV-sized derivatives in Hearth's writable data directory.
# The source path is server-only and is never returned to browsers or logs.
# HEARTH_PHOTO_SOURCE_DIR=/photos-source
# HEARTH_PHOTO_DERIVATIVE_DIR=/data/photo-derivatives
# HEARTH_PHOTO_COLLECTION_NAME=Family photos
# HEARTH_PHOTO_SCAN_MINUTES=15

# Optional private-mode Home Assistant adapter. This is a writable server-only
# JSON secret path outside the repository; Admin can atomically create/replace
# it with mode 0600 after an adult tests and maps the approved local entities.
# Never paste a Home Assistant token into .env. Demo mode rejects this path.
# HEARTH_HOME_ASSISTANT_CONFIG_PATH=/run/secrets/hearth-home-assistant.json

# Browser-safe path only. Never place service credentials in a VITE_ variable.
VITE_HEARTH_API_BASE=/api/v1
