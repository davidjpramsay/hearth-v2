<?xml version="1.0" encoding="utf-8"?>
<!-- Original Hearth fern to the left of the wordmark, on a bounded 16:9 canvas. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="160dp" android:height="90dp">
        <shape><solid android:color="#214F43" /></shape>
    </item>
    <item android:width="60dp" android:height="60dp"
        android:left="0dp" android:top="17dp" android:gravity="left|top"
        android:drawable="@drawable/tv_launcher_fern" />
    <item android:width="160dp" android:height="90dp" android:gravity="left|top"
        android:drawable="@drawable/tv_wordmark" />
</layer-list>
